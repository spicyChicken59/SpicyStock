# Private service only. Never put these values in docs/, browser storage, or Pages secrets.
# Copy to deploy/broker/bridge.env (gitignored). Register this exact HTTPS callback:
# https://YOUR-PRIVATE-HOST/api/oauth/callback
BRIDGE_ORIGIN=https://YOUR-PRIVATE-HOST
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Preserve the key outside the container together with a protected database backup.
BRIDGE_ENCRYPTION_KEY=
BRIDGE_DATABASE=/data/broker.sqlite3
# Paper is the default. Enabling live also requires an exact account-ID allowlist.
BRIDGE_LIVE_ENABLED=false
BRIDGE_LIVE_ACCOUNT_IDS=
# Defaults to checked-in data/symbols.txt, the app's curated stock scope.
# Optional explicit override; an empty override disables entries:
# BRIDGE_COMMON_STOCK_SYMBOLS=AAPL,MSFT
# Optional absolute path to an operator-maintained stock symbol file:
# BRIDGE_COMMON_STOCK_FILE=/app/data/symbols.txt
# Server-enforced ceilings, not recommended or automatically selected trade settings.
BRIDGE_MAX_POSITIONS=5
BRIDGE_MAX_RISK_PERCENT=1
BRIDGE_MAX_POSITION_PERCENT=25
BRIDGE_MAX_NOTIONAL=5000
