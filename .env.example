# Copy this file, don't edit it in place — .env is gitignored, this one isn't.
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# SINGLE-QUOTE EVERY VALUE, ALWAYS. That second line runs .env as a shell
# script, so an unquoted value is executed: `re_a>out.txt` writes a file and
# truncates the key, `sk-ant-$(whoami)` runs a command, and an unquoted
# `Alerts <a@b.com>` is a syntax error that leaves the variable empty.
# Single quotes stop all of it. (A value containing a literal ' can't be
# loaded this way — use python-dotenv if you ever hit that.)
#
# In GitHub Actions these come from repository secrets, not this file.
# evening.yml forwards all of them except CLAUDE_MODEL, which is local-only.

# --- Required -------------------------------------------------------------
# None of these fail at startup. A missing ANTHROPIC_API_KEY is the worst
# case: the run completes and emails you checklist scores instead of AI ones.

# Alpaca (https://alpaca.markets -> Home -> API Keys).
# Use PAPER keys — src/scanner.py:78 hardcodes paper=True, so live keys fail
# to authenticate. Nothing here places orders; the trading client only lists
# assets. Note a free Alpaca plan serves IEX data, a fraction of consolidated
# volume, which the scanner's 5,000,000-share threshold is not calibrated for.
ALPACA_API_KEY=''
ALPACA_SECRET_KEY=''

# Anthropic (https://console.anthropic.com -> API Keys). Needs billing enabled.
# Read implicitly by anthropic.Anthropic() in src/scorer.py:56.
ANTHROPIC_API_KEY=''

# Resend (https://resend.com/api-keys). Not needed for --dry-run.
RESEND_API_KEY=''

# Recipients, comma-separated. Not needed for --dry-run.
EMAIL_TO='you@example.com'

# --- Optional -------------------------------------------------------------

# Sender. Defaults to onboarding@resend.dev (src/emailer.py:108), which Resend
# only delivers to the account owner — set a verified-domain sender to mail
# anyone else. In CI that default never applies: evening.yml always sets this,
# so an unset repository secret becomes '' rather than the default.
# RESEND_FROM='alerts@yourdomain.com'

# Defaults to claude-sonnet-4-6 (src/scorer.py:25). Local only.
# CLAUDE_MODEL='claude-sonnet-4-6'
