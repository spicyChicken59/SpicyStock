# Copy this file, don't edit it in place — .env is gitignored, this one isn't.
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# Quote every value in single quotes. That second line sources .env as a shell
# script, so an unquoted value gets executed or mangled. For a literal
# apostrophe inside a value, close-escape-reopen: PASS='it'\''s'
#
# In GitHub Actions these come from repository secrets and variables, not from
# this file. evening.yml forwards the six secrets, the four repository
# VARIABLES (SCAN_FEED, SCAN_UNIVERSE, ACCOUNT_EQUITY, RISK_PCT),
# SCAN_SESSION_DATE from the Run-workflow form's `session` box (a scheduled
# run sends '' = unset), SCAN_SEND_EMAIL from its `skip_email` box and the
# --dry-run flag from its `dry_run` box. intraday.yml forwards the Alpaca and
# Resend variables only: the intraday check grades nothing. CLAUDE_MODEL,
# MAX_POSITION_PCT and MAX_OPEN_POSITIONS are read locally only.
#
# What an evening run writes: docs/data.json (rewritten every night),
# docs/picks.json (every published plan, appended), docs/charts/<TICKER>.png
# (gitignored; the image the grader saw). --dry-run writes data.json and the
# charts, mails nothing and records no pick. `git checkout -- docs/` puts the
# committed record back after a local run.

# --- Required -------------------------------------------------------------
# All are checked by preflight() BEFORE anything is fetched or paid for, so a
# missing one costs nothing, and the message names every missing variable.
# Which are required depends on the run: `evening` needs all six; `evening
# --dry-run` and SCAN_SEND_EMAIL=false drop the two delivery ones; `intraday`
# needs the Alpaca pair and the delivery pair. An empty value counts as
# missing (an unset repository secret arrives as '').

# Alpaca (https://alpaca.markets -> API Keys). Paper or live keys both work:
# only the historical-data client is built, and nothing here places an order.
# The scan reads the consolidated `sip` daily bars with its request window
# held sixteen minutes behind the clock, which is the free plan's route; the
# intraday check reads IEX snapshots for the price and delayed SIP for the
# partial-day volume. `delayed_sip` is a name the bars endpoint refuses.
ALPACA_API_KEY=''
ALPACA_SECRET_KEY=''

# Anthropic (https://console.anthropic.com -> API Keys). Needs billing.
# At most MAX_READS (12) chart reads a night, two attempts each; a refused
# credential stops the calls after the first and the night is graded by the
# checklist alone, marked degraded.
ANTHROPIC_API_KEY=''

# Resend (https://resend.com/api-keys). Not needed for --dry-run.
RESEND_API_KEY=''

# Recipients, comma-separated. Until a domain is verified at
# resend.com/domains, Resend delivers only to the address the account is
# registered under, exactly as spelled; the run log diagnoses a refusal and
# corrects a capital letter on the spot.
EMAIL_TO='you@example.com'

# --- Optional locally, but set them in CI --------------------------------

# Sender. Falls back to onboarding@resend.dev, which Resend delivers only to
# the account owner. Set a verified-domain sender to mail anyone else.
# RESEND_FROM='alerts@yourdomain.com'

# The account the plans are sized for. Defaults: $10,000, 0.5% risk a trade
# (inside Bonde's 0.25-1% band), 25% of equity in any one name, four open
# positions. Every plan prints its shares from these, and the page's order
# sheet reads them back beside each ticket.
# ACCOUNT_EQUITY='10000'
# RISK_PCT='0.5'
# MAX_POSITION_PCT='25'
# MAX_OPEN_POSITIONS='4'

# --- Optional: overriding the data request --------------------------------
# Each raises on a value it does not understand rather than falling back: a
# typo must not quietly change which data the run read.

# Which Alpaca feed the daily bars come from: sip (default) or iex. A feed
# the account may not query aborts the run with FeedNotAuthorizedError
# naming it; a rejected KEY is CredentialsRejectedError, and this is not its
# fix. Set 'iex' to read the free single-venue feed, which needs no hold-back
# and carries a fraction of the consolidated volume.
# SCAN_FEED='sip'

# Which stocks to read: 'directory' (default, and the workflow's setting)
# refreshes Nasdaq's stock directory and admits every US-listed common stock
# at $3 and 100,000 shares (about 3,000 names; foreign and biotech are flags
# on the page, not exclusions); 'seed' reads data/symbols.txt (228 names) and
# asks nothing of the network. A directory that will not answer falls back to
# its gzip cache under docs/ for up to seven days, then to the seed, and the
# run is marked degraded either way (`universe_cached`).
# SCAN_UNIVERSE='directory'

# Scan a session other than the one the clock says: a backfill. YYYY-MM-DD.
# The workflow forwards it from the Run-workflow form's `session` box.
# SCAN_SESSION_DATE='2026-09-10'

# Publish the record without mailing it (the form's `skip_email` box).
# SCAN_SEND_EMAIL='true'

# The grading model. Local only; the workflow always runs the default.
# CLAUDE_MODEL='claude-sonnet-4-6'
