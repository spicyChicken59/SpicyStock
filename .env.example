# Copy to .env for local runs:
#
#     cp .env.example .env      # then fill it in
#     set -a; . ./.env; set +a  # load it into your shell
#
# Single-quote any value containing a space, '#', or '='.
#
# Do NOT use `export $(grep -v '^#' .env | xargs)`. It truncates values at the
# first space, echoes secret fragments to stderr as "not a valid identifier",
# and if any value contains an apostrophe, xargs aborts, the substitution
# collapses to empty, and a bare `export` dumps your ENTIRE environment to
# stdout — with exit code 0, so it looks like it worked.
#
# .env is gitignored. Never commit real values, and do not fill this file in
# place — copy it first, or you will commit your keys.
#
# In GitHub Actions these come from repository secrets instead
# (Settings -> Secrets and variables -> Actions), not from this file.
# .github/workflows/evening.yml forwards all of the below EXCEPT CLAUDE_MODEL,
# which is local-only — CI always runs the default model.

# ---------------------------------------------------------------------------
# REQUIRED — set all five for a real run.
#
# Be aware: the pipeline does NOT fail fast if you miss one. See the notes at
# the bottom of this file. `--dry-run` skips the email and so needs neither
# Resend variable.
# ---------------------------------------------------------------------------

# Market data + the tradable universe (https://alpaca.markets -> Home -> API Keys).
#
# PAPER-TRADING KEYS ARE REQUIRED, not merely preferred: src/scanner.py:78
# hardcodes TradingClient(..., paper=True), so live-account keys will fail to
# authenticate and kill the scan inside get_universe(). Nothing in this project
# places orders — the trading client is used only to list assets.
#
# NOTE: a free/Basic Alpaca plan serves IEX data only, which reports a small
# fraction of consolidated volume. The scanner's 5,000,000-share threshold
# (src/scanner.py:54) is calibrated for full-tape numbers, so on a free plan
# almost nothing will pass and you will get an empty shortlist every day.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Claude scoring (https://console.anthropic.com -> API Keys). Needs billing enabled.
# Read implicitly by anthropic.Anthropic() in src/scorer.py:56.
ANTHROPIC_API_KEY=

# Email delivery (https://resend.com/api-keys).
RESEND_API_KEY=

# Recipient(s). Comma-separated for multiple — quote the value if you use more
# than one, e.g. EMAIL_TO='a@example.com, b@example.com'
EMAIL_TO=

# ---------------------------------------------------------------------------
# OPTIONAL — real defaults in code; set only to override
# ---------------------------------------------------------------------------

# Sender address. Defaults to onboarding@resend.dev (src/emailer.py:108), which
# Resend only permits to deliver to the account owner's own address — set a
# verified-domain sender before mailing anyone else.
# RESEND_FROM=alerts@yourdomain.com

# Scoring model. Defaults to claude-sonnet-4-6 (src/scorer.py:25).
# Local only — the workflow does not forward this.
# CLAUDE_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# How each missing value actually fails — none of these fail at startup
# ---------------------------------------------------------------------------
#
# ANTHROPIC_API_KEY  The run COMPLETES and emails you scores. src/scorer.py:115
#                    catches the auth error per candidate and substitutes a
#                    2LYNCH-ratio fallback, so a plausible-looking score and a
#                    "B" verdict ship with only a small "not AI-reviewed" note
#                    to tell you no AI review happened. This is the dangerous one.
#
# ALPACA_*           Read with a "" fallback (src/scanner.py:46-47), so a blank
#                    value does not raise at startup — it surfaces later as an
#                    opaque authentication error, part-way into the run.
#
# RESEND_API_KEY     Read at the very END (src/emailer.py:107,112), after the
# EMAIL_TO           full scan and every Claude call. A missing value costs you
#                    the run's Claude spend and the email; the CSV is already
#                    written by then (src/pipeline.py:83).
#
# Making these fail loudly and early is a later step in the rebuild.
