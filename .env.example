# Claude API (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Gmail via "Sign in with Google" (OAuth) — run scripts/setup_gmail_oauth.py
# once locally to obtain the refresh token. See README for the full steps.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//0g...
GMAIL_SENDER=you@gmail.com
EMAIL_TO=manager@example.com

# (Optional legacy fallback — only used if GOOGLE_REFRESH_TOKEN is empty)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
