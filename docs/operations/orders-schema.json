     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "data_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "morning_sha256": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{64}$"
    },
