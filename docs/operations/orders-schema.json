     "type": [
      "string",
      "null"
     ]
    },
    "session": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "applicable_session": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tickets": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/morning_ticket"
     }
    },
    "summary": {
     "type": "object",
