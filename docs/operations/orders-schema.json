    },
    "quantity": {
     "enum": [
      "all",
      "half",
      "remainder"
     ]
    },
    "shares": {
     "type": "integer",
     "minimum": 1
    },
    "at": {
     "enum": [
      "open",
      "stop",
      "close",
      "the_higher_of_open_and_level"
     ]
    },
    "order_type": {
     "enum": [
      "stop_market"
     ]
    },
    "stop_to": {
     "enum": [
      "day_high_minus",
      "entry_day_low",
      "day_low"
     ]
    },
    "cents": {
     "type": "number"
    },
    "cents_max": {
     "type": "number"
    },
    "only_up": {
     "type": "boolean"
    },
    "take": {
     "enum": [
      "partial_profit"
     ]
    },
    "do_not": {
     "enum": [
      "move_stop_to_breakeven"
     ]
    }
   },
   "required": [
    "action"
   ],
   "additionalProperties": false
  },
