# Secrets — never commit. The pipeline reads these from the environment;
# in GitHub Actions they come from repository secrets, not from a file.
.env
.env.*
*.env
.env~
.envrc
!.env.example

# Credential files that tooling drops into a repo. The Google Cloud console
# downloads client_secret_*.json, and Google's OAuth libraries conventionally
# write token.json / credentials.json — relevant here because SETUP.md still
# walks through the Gmail OAuth flow and then says to run `git add .`
# (SETUP.md:89).
# A filename denylist can never be complete. The real backstop is GitHub
# secret scanning with push protection — turn it on.
secrets.json
secrets.yaml
secrets.yml
credentials*.json
client_secret*.json
token.json
*.pem
*.key

# Run artifacts. archive() writes results/ on every run (src/pipeline.py:36);
# render_chart() writes charts/ whenever a candidate clears the 2LYNCH gate
# (src/scorer.py:30). Without these rules a local run leaves the repo dirty.
results/
charts/

# Written into the working directory by tests/test_pipeline.py. That suite
# currently cannot run at all — it imports detect_burst, which src/scanner.py
# does not define — so this rule is for once that is fixed.
results_preview.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtualenvs
.venv/
venv/
env/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
