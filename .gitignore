# Secrets — never commit. The pipeline reads these from the environment;
# in GitHub Actions they come from repository secrets, not from a file.
.env
.env.*
*.env
.env~
.envrc
!.env*.example

# Credential files that tooling drops into a repo. The Google Cloud console
# downloads client_secret_*.json, and Google's OAuth libraries conventionally
# write token.json / credentials.json — relevant here because SETUP.md still
# walks through the Gmail OAuth flow and then says to run `git add .`
# (SETUP.md:101).
# A filename denylist can never be complete. The backstops are the gitleaks
# job in .github/workflows/secret-scan.yml and GitHub push protection.
secrets.json
secrets.yaml
secrets.yml
secrets.toml
secrets/
credentials*.json
client_secret*.json
token.json
*.pem
*.key

# Logs. A redirected run (`python -m src.pipeline evening > run.log 2>&1`)
# lands here, and `git add .` would commit it.
*.log
logs/
nohup.out

# Run artifacts, written into the repo root. Anchored with a leading slash so
# a tests/fixtures/results/ or docs/charts/ directory is not swallowed too.
# archive() writes results/ on every run; render_chart() writes charts/
# whenever a candidate clears the 2LYNCH gate.
/results/
/charts/

# Written into the working directory by tests/test_pipeline.py. That suite
# currently cannot run at all — it imports detect_burst, which src/scanner.py
# does not define — so this rule is for once that is fixed.
results_preview.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtualenvs. Anchored: an `env/` package elsewhere in the tree is source.
/.venv/
/venv/
/env/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
